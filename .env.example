# Server-side only — never prefix with VITE_, never commit real values.

# Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. "gemini-flash-latest" tracks Google's current
# recommended flash model, so it doesn't need updating as versions are
# deprecated. Pin an exact version instead if you need output stability.
# See https://ai.google.dev/gemini-api/docs/models for the full list.
GEMINI_MODEL=gemini-flash-latest
