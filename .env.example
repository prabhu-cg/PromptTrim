# Server-side only — never prefix with VITE_, never commit real values.

# Groq API key. Get one at https://console.groq.com/keys — no card required.
GROQ_API_KEY=

# Groq model id. openai/gpt-oss-120b is the current default: strong
# instruction-following, 1,000 requests/day on the free tier. Check
# https://console.groq.com/docs/models for the current lineup — Groq's
# hosted models change over time (e.g. Llama 3.x models were removed
# from the catalog after this was first written).
# See https://console.groq.com/docs/rate-limits for current limits.
GROQ_MODEL=openai/gpt-oss-120b
